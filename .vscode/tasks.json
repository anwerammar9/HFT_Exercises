{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "CMake: build (Debug)",
            "command": "cmake --build build",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Builds the whole project (all exercise tests) via the build/ Ninja configuration."
        },
        {
            "type": "shell",
            "label": "CMake: rebuild",
            "command": "cmake --build build --clean-first",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Clean rebuild of the whole project."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}